#!/usr/bin/env bash
# Instalador TUI para skill ICFES.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd -P)"
SKILL_NAME="icfes-item-workflow"
AGENT_NAME="icfes-item-coach.md"
if [ -t 1 ]; then
  BOLD="$(tput bold 2>/dev/null || true)"
  DIM="$(tput dim 2>/dev/null || true)"
  GREEN="$(tput setaf 2 2>/dev/null || true)"
  CYAN="$(tput setaf 6 2>/dev/null || true)"
  YELLOW="$(tput setaf 3 2>/dev/null || true)"
  RED="$(tput setaf 1 2>/dev/null || true)"
  RESET="$(tput sgr0 2>/dev/null || true)"
else
  BOLD=""; DIM=""; GREEN=""; CYAN=""; YELLOW=""; RED=""; RESET=""
fi

usage() {
  cat <<'EOF'
Uso:
  ./setup                         # menu TUI
  ./setup --target codex --scope user
  ./setup --target codex --scope project [--project DIR]
  ./setup --target claude --scope user
  ./setup --target agents --scope project [--project DIR]

Targets:
  codex   -> ~/.codex/skills o .agents/skills
  claude  -> ~/.claude/skills o .claude/skills
  gemini  -> ~/.gemini/skills o .agents/skills
  cursor  -> ~/.agents/skills o .agents/skills
  windsurf -> ~/.agents/skills o .agents/skills
  opencode -> ~/.config/opencode/skills o .opencode/skills
  kiro    -> ~/.kiro/skills o .kiro/skills
  aider   -> ~/.agents/skills o .agents/skills
  goose   -> ~/.config/goose/skills o .goose/skills
  zed     -> ~/.agents/skills o .agents/skills
  vscode  -> ~/.agents/skills o .agents/skills
  cline   -> ~/.agents/skills o .agents/skills
  roo     -> ~/.agents/skills o .agents/skills
  continue -> ~/.agents/skills o .agents/skills
  trae    -> ~/.agents/skills o .agents/skills
  augment -> ~/.agents/skills o .agents/skills
  amp     -> ~/.agents/skills o .agents/skills
  agents  -> ~/.agents/skills o .agents/skills portable
EOF
}

TARGET=""
TARGETS=""
SCOPE=""
PROJECT_DIR="$(pwd)"
COPY_MODE="copy"

while [ $# -gt 0 ]; do
  case "$1" in
    --target) TARGET="${2:-}"; shift 2 ;;
    --target=*) TARGET="${1#--target=}"; shift ;;
    --scope) SCOPE="${2:-}"; shift 2 ;;
    --scope=*) SCOPE="${1#--scope=}"; shift ;;
    --project) PROJECT_DIR="${2:-}"; shift 2 ;;
    --project=*) PROJECT_DIR="${1#--project=}"; shift ;;
    --link) COPY_MODE="link"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Opcion desconocida: $1" >&2; usage; exit 1 ;;
  esac
done

need_source() {
  [ -f "$ROOT/skills/$SKILL_NAME/SKILL.md" ] || {
    echo "Falta skill: $ROOT/skills/$SKILL_NAME/SKILL.md" >&2
    exit 1
  }
}

normalize_target() {
  case "$1" in
    codex|Codex) echo "codex" ;;
    claude|Claude|claude-code|"Claude Code") echo "claude" ;;
    gemini|Gemini) echo "gemini" ;;
    cursor|Cursor) echo "cursor" ;;
    windsurf|Windsurf) echo "windsurf" ;;
    opencode|OpenCode|open-code|"Open Code") echo "opencode" ;;
    kiro|Kiro) echo "kiro" ;;
    aider|Aider) echo "aider" ;;
    goose|Goose) echo "goose" ;;
    zed|Zed|ZED) echo "zed" ;;
    vscode|VSCode|"VS Code"|code|Code) echo "vscode" ;;
    cline|Cline) echo "cline" ;;
    roo|Roo|roo-code|"Roo Code") echo "roo" ;;
    continue|Continue) echo "continue" ;;
    trae|Trae) echo "trae" ;;
    augment|Augment) echo "augment" ;;
    amp|Amp|AMP) echo "amp" ;;
    agents|Agents|portable|Portable|other|Other) echo "agents" ;;
    *) echo "$1" ;;
  esac
}

normalize_scope() {
  case "$1" in
    user|global|Global|usuario|Usuario) echo "user" ;;
    project|proyecto|Project|Proyecto|local|Local) echo "project" ;;
    *) echo "$1" ;;
  esac
}

choose() {
  local prompt="$1"
  shift
  local opts=("$@")
  local i choice opt opt_name
  while true; do
    echo >&2
    echo "${BOLD}${prompt}${RESET}" >&2
    for i in "${!opts[@]}"; do
      printf "  ${CYAN}%d${RESET}) %s\n" "$((i + 1))" "${opts[$i]}" >&2
    done
    printf "${DIM}Enter = opcion 1. Numero/nombre, q = salir:${RESET} " >&2
    if [ -t 0 ] && [ -r /dev/tty ]; then
      read -r choice </dev/tty
    else
      read -r choice
    fi
    if [ -z "$choice" ]; then
      echo "${opts[0]}"
      return 0
    fi
    case "$choice" in
      q|quit|exit|salir)
        echo "__exit__"
        return 0
        ;;
      *[!0-9]*)
        for opt in "${opts[@]}"; do
          opt_name="${opt%% *}"
          if [ "$choice" = "$opt_name" ] || [ "$choice" = "$opt" ]; then
            echo "$opt"
            return 0
          fi
        done
        echo "${RED}Seleccion invalida:${RESET} $choice" >&2
        ;;
      *)
        if [ "$choice" -ge 1 ] && [ "$choice" -le "${#opts[@]}" ]; then
          echo "${opts[$((choice - 1))]}"
          return 0
        fi
        echo "${RED}Seleccion invalida:${RESET} $choice" >&2
        ;;
    esac
  done
}

choose_multi() {
  local prompt="$1"
  shift
  local opts=("$@")
  local i choice token opt opt_name target normalized found out seen
  while true; do
    echo >&2
    echo "${BOLD}${prompt}${RESET}" >&2
    for i in "${!opts[@]}"; do
      printf "  ${CYAN}%d${RESET}) %s\n" "$((i + 1))" "${opts[$i]}" >&2
    done
    printf "${DIM}Enter = opcion 1. Varios: 1,2,6 o codex claude. all = todos. q = salir:${RESET} " >&2
    if [ -t 0 ] && [ -r /dev/tty ]; then
      read -r choice </dev/tty
    else
      read -r choice
    fi
    if [ -z "$choice" ]; then
      echo "$(normalize_target "${opts[0]%% *}")"
      return 0
    fi
    case "$choice" in
      q|quit|exit|salir)
        echo "__exit__"
        return 0
        ;;
      all|todos|todas)
        out=""
        seen=""
        for opt in "${opts[@]}"; do
          target="$(normalize_target "${opt%% *}")"
          case " $seen " in
            *" $target "*) ;;
            *) out="${out:+$out }$target"; seen="${seen:+$seen }$target" ;;
          esac
        done
        echo "$out"
        return 0
        ;;
    esac

    out=""
    seen=""
    found=1
    choice="${choice//,/ }"
    choice="${choice//;/ }"
    for token in $choice; do
      normalized=""
      case "$token" in
        '' ) continue ;;
        *[!0-9]*)
          for opt in "${opts[@]}"; do
            opt_name="${opt%% *}"
            if [ "$token" = "$opt_name" ] || [ "$token" = "$opt" ]; then
              normalized="$(normalize_target "$opt_name")"
              break
            fi
          done
          ;;
        *)
          if [ "$token" -ge 1 ] && [ "$token" -le "${#opts[@]}" ]; then
            normalized="$(normalize_target "${opts[$((token - 1))]%% *}")"
          fi
          ;;
      esac

      if [ -z "$normalized" ]; then
        echo "${RED}Seleccion invalida:${RESET} $token" >&2
        found=0
        break
      fi
      case " $seen " in
        *" $normalized "*) ;;
        *) out="${out:+$out }$normalized"; seen="${seen:+$seen }$normalized" ;;
      esac
    done

    if [ "$found" -eq 1 ] && [ -n "$out" ]; then
      echo "$out"
      return 0
    fi
  done
}

prompt_path() {
  local default_path="$1"
  local answer
  printf "Ruta del proyecto [%s]: " "$default_path" >&2
  if [ -t 0 ] && [ -r /dev/tty ]; then
    read -r answer </dev/tty
  else
    read -r answer
  fi
  [ -n "${answer:-}" ] && echo "$answer" || echo "$default_path"
}

target_options() {
  local detected opt canonical
  detected="$(detect_target)"
  for opt in \
    codex \
    claude \
    gemini \
    cursor \
    windsurf \
    opencode \
    kiro \
    aider \
    goose \
    zed \
    vscode \
    cline \
    roo \
    continue \
    trae \
    augment \
    amp \
    agents
  do
    canonical="$(normalize_target "$opt")"
    if [ "$canonical" = "$detected" ]; then
      printf '%s (detectado)\n' "$opt"
    else
      printf '%s\n' "$opt"
    fi
  done
}

pick_targets() {
  local opts opt
  opts=()
  while IFS= read -r opt; do
    opts+=("$opt")
  done < <(target_options)
  choose_multi "IDE/agente destino (puedes escoger varios):" "${opts[@]}"
}

doctor() {
  need_source
  echo
  echo "${GREEN}ICFES Skill OK.${RESET}"
  echo "  root:   $ROOT"
  echo "  skill:  $ROOT/skills/$SKILL_NAME"
  [ -f "$ROOT/agents/$AGENT_NAME" ] && echo "  agente: $ROOT/agents/$AGENT_NAME"
}

run_menu() {
  local action picked
  echo "${BOLD}ICFES Skill Setup${RESET}"
  echo "${DIM}-----------------${RESET}"
  echo "Instala skill ICFES para tu IDE/agente."
  echo "${DIM}Global = disponible en todos los proyectos. Proyecto = queda versionable en repo.${RESET}"

  action="$(choose "Que quieres hacer:" \
    "global (instalar para todos los proyectos)" \
    "current (instalar en este proyecto)" \
    "other (instalar en otro proyecto)" \
    "doctor (verificar instalacion)" \
    "exit (salir)")"
  action="${action%% *}"
  if [ "$action" = "__exit__" ]; then
    echo "${YELLOW}Instalacion cancelada.${RESET}"
    exit 0
  fi

  case "$action" in
    global)
      picked="$(pick_targets)"
      if [ "$picked" = "__exit__" ]; then echo "${YELLOW}Instalacion cancelada.${RESET}"; exit 0; fi
      TARGETS="$picked"
      SCOPE="user"
      ;;
    current)
      picked="$(pick_targets)"
      if [ "$picked" = "__exit__" ]; then echo "${YELLOW}Instalacion cancelada.${RESET}"; exit 0; fi
      TARGETS="$picked"
      SCOPE="project"
      PROJECT_DIR="$(pwd)"
      ;;
    other)
      picked="$(pick_targets)"
      if [ "$picked" = "__exit__" ]; then echo "${YELLOW}Instalacion cancelada.${RESET}"; exit 0; fi
      TARGETS="$picked"
      SCOPE="project"
      PROJECT_DIR="$(prompt_path "$PROJECT_DIR")"
      ;;
    doctor)
      doctor
      exit 0
      ;;
    exit)
      echo "Instalacion cancelada."
      exit 0
      ;;
  esac
}

detect_target() {
  command -v codex >/dev/null 2>&1 && { echo "codex"; return; }
  command -v claude >/dev/null 2>&1 && { echo "claude"; return; }
  command -v gemini >/dev/null 2>&1 && { echo "gemini"; return; }
  command -v opencode >/dev/null 2>&1 && { echo "opencode"; return; }
  command -v kiro-cli >/dev/null 2>&1 && { echo "kiro"; return; }
  command -v aider >/dev/null 2>&1 && { echo "aider"; return; }
  command -v goose >/dev/null 2>&1 && { echo "goose"; return; }
  command -v code >/dev/null 2>&1 && { echo "vscode"; return; }
  command -v zed >/dev/null 2>&1 && { echo "zed"; return; }
  command -v amp >/dev/null 2>&1 && { echo "amp"; return; }
  echo "agents"
}

dest_dir() {
  local target="$1"
  local scope="$2"
  local project="$3"
  case "$scope:$target" in
    user:codex) echo "$HOME/.codex/skills" ;;
    user:claude) echo "$HOME/.claude/skills" ;;
    user:gemini) echo "$HOME/.gemini/skills" ;;
    user:opencode) echo "$HOME/.config/opencode/skills" ;;
    user:kiro) echo "$HOME/.kiro/skills" ;;
    user:goose) echo "$HOME/.config/goose/skills" ;;
    user:cursor) echo "$HOME/.agents/skills" ;;
    user:windsurf) echo "$HOME/.agents/skills" ;;
    user:aider) echo "$HOME/.agents/skills" ;;
    user:zed) echo "$HOME/.agents/skills" ;;
    user:vscode) echo "$HOME/.agents/skills" ;;
    user:cline) echo "$HOME/.agents/skills" ;;
    user:roo) echo "$HOME/.agents/skills" ;;
    user:continue) echo "$HOME/.agents/skills" ;;
    user:trae) echo "$HOME/.agents/skills" ;;
    user:augment) echo "$HOME/.agents/skills" ;;
    user:amp) echo "$HOME/.agents/skills" ;;
    user:agents) echo "$HOME/.agents/skills" ;;
    project:claude) echo "$project/.claude/skills" ;;
    project:opencode) echo "$project/.opencode/skills" ;;
    project:kiro) echo "$project/.kiro/skills" ;;
    project:goose) echo "$project/.goose/skills" ;;
    project:*) echo "$project/.agents/skills" ;;
  esac
}

install_dir() {
  local src="$1"
  local dst="$2"
  mkdir -p "$(dirname "$dst")"
  rm -rf "$dst"
  if [ "$COPY_MODE" = "link" ]; then
    ln -s "$src" "$dst"
  else
    cp -R "$src" "$dst"
  fi
}

install_agent() {
  local target="$1"
  local scope="$2"
  local project="$3"
  local agent_src="$ROOT/agents/$AGENT_NAME"
  [ -f "$agent_src" ] || return 0

  if [ "$scope" = "project" ]; then
    mkdir -p "$project/agents"
    cp "$agent_src" "$project/agents/$AGENT_NAME"
    return 0
  fi

  case "$target" in
    codex) mkdir -p "$HOME/.codex/agents"; cp "$agent_src" "$HOME/.codex/agents/$AGENT_NAME" ;;
    claude) mkdir -p "$HOME/.claude/agents"; cp "$agent_src" "$HOME/.claude/agents/$AGENT_NAME" ;;
    gemini) mkdir -p "$HOME/.gemini/agents"; cp "$agent_src" "$HOME/.gemini/agents/$AGENT_NAME" ;;
    opencode) mkdir -p "$HOME/.config/opencode/agents"; cp "$agent_src" "$HOME/.config/opencode/agents/$AGENT_NAME" ;;
    kiro) mkdir -p "$HOME/.kiro/agents"; cp "$agent_src" "$HOME/.kiro/agents/$AGENT_NAME" ;;
    goose) mkdir -p "$HOME/.config/goose/agents"; cp "$agent_src" "$HOME/.config/goose/agents/$AGENT_NAME" ;;
    cursor|windsurf|aider|zed|vscode|cline|roo|continue|trae|augment|amp|agents) mkdir -p "$HOME/.agents/agents"; cp "$agent_src" "$HOME/.agents/agents/$AGENT_NAME" ;;
  esac
}

run_install() {
  local target="$1"
  local scope="$2"
  local project="$3"
  need_source
  case "$target" in
    codex|claude|gemini|cursor|windsurf|opencode|kiro|aider|goose|zed|vscode|cline|roo|continue|trae|augment|amp|agents) ;;
    *) echo "Target invalido: $target" >&2; exit 1 ;;
  esac
  case "$scope" in
    user|project) ;;
    *) echo "Scope invalido: $scope" >&2; exit 1 ;;
  esac

  local base dst
  base="$(dest_dir "$target" "$scope" "$project")"
  dst="$base/$SKILL_NAME"
  mkdir -p "$base"
  install_dir "$ROOT/skills/$SKILL_NAME" "$dst"
  install_agent "$target" "$scope" "$project"

  echo
  echo "${GREEN}ICFES skill instalado.${RESET}"
  echo "  target: $target"
  echo "  scope:  $scope"
  echo "  skill:  $dst"
  if [ "$scope" = "project" ]; then
    echo "  agente: $project/agents/$AGENT_NAME"
  fi
}

if [ -z "$TARGET" ] || [ -z "$SCOPE" ]; then
  run_menu
fi

if [ -z "$TARGETS" ] && { [ "${TARGET#*,}" != "$TARGET" ] || [ "${TARGET#* }" != "$TARGET" ]; }; then
  raw_targets="${TARGET//,/ }"
  for raw_target in $raw_targets; do
    TARGETS="${TARGETS:+$TARGETS }$(normalize_target "$raw_target")"
  done
  TARGET=""
fi

SCOPE="$(normalize_scope "$SCOPE")"
if [ -n "$TARGETS" ]; then
  for target in $TARGETS; do
    run_install "$target" "$SCOPE" "$PROJECT_DIR"
  done
else
  TARGET="$(normalize_target "$TARGET")"
  run_install "$TARGET" "$SCOPE" "$PROJECT_DIR"
fi
