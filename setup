#!/usr/bin/env bash
# Instalador TUI para skill ICFES.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd -P)"
SKILL_NAME="icfes-item-workflow"
AGENT_NAME="icfes-item-coach.md"
if [ -t 1 ]; then
  BOLD="$(tput bold 2>/dev/null || true)"
  DIM="$(tput dim 2>/dev/null || true)"
  GREEN="$(tput setaf 2 2>/dev/null || true)"
  CYAN="$(tput setaf 6 2>/dev/null || true)"
  YELLOW="$(tput setaf 3 2>/dev/null || true)"
  RED="$(tput setaf 1 2>/dev/null || true)"
  RESET="$(tput sgr0 2>/dev/null || true)"
else
  BOLD=""; DIM=""; GREEN=""; CYAN=""; YELLOW=""; RED=""; RESET=""
fi

usage() {
  cat <<'EOF'
Uso:
  ./setup                         # menu TUI
  ./setup --target codex --scope user
  ./setup --target codex --scope project [--project DIR]
  ./setup --target claude --scope user
  ./setup --target agents --scope project [--project DIR]

Targets:
  codex   -> ~/.codex/skills o .agents/skills
  claude  -> ~/.claude/skills o .claude/skills
  gemini  -> ~/.gemini/skills o .agents/skills
  cursor  -> ~/.agents/skills o .agents/skills
  windsurf -> ~/.agents/skills o .agents/skills
  opencode -> ~/.config/opencode/skills o .opencode/skills
  kiro    -> ~/.kiro/skills o .kiro/skills
  agents  -> ~/.agents/skills o .agents/skills portable
EOF
}

TARGET=""
SCOPE=""
PROJECT_DIR="$(pwd)"
COPY_MODE="copy"

while [ $# -gt 0 ]; do
  case "$1" in
    --target) TARGET="${2:-}"; shift 2 ;;
    --target=*) TARGET="${1#--target=}"; shift ;;
    --scope) SCOPE="${2:-}"; shift 2 ;;
    --scope=*) SCOPE="${1#--scope=}"; shift ;;
    --project) PROJECT_DIR="${2:-}"; shift 2 ;;
    --project=*) PROJECT_DIR="${1#--project=}"; shift ;;
    --link) COPY_MODE="link"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Opcion desconocida: $1" >&2; usage; exit 1 ;;
  esac
done

need_source() {
  [ -f "$ROOT/skills/$SKILL_NAME/SKILL.md" ] || {
    echo "Falta skill: $ROOT/skills/$SKILL_NAME/SKILL.md" >&2
    exit 1
  }
}

normalize_target() {
  case "$1" in
    codex|Codex) echo "codex" ;;
    claude|Claude|claude-code|"Claude Code") echo "claude" ;;
    gemini|Gemini) echo "gemini" ;;
    cursor|Cursor) echo "cursor" ;;
    windsurf|Windsurf) echo "windsurf" ;;
    opencode|OpenCode|open-code|"Open Code") echo "opencode" ;;
    kiro|Kiro) echo "kiro" ;;
    agents|Agents|portable|Portable|other|Other) echo "agents" ;;
    *) echo "$1" ;;
  esac
}

normalize_scope() {
  case "$1" in
    user|global|Global|usuario|Usuario) echo "user" ;;
    project|proyecto|Project|Proyecto|local|Local) echo "project" ;;
    *) echo "$1" ;;
  esac
}

choose() {
  local prompt="$1"
  shift
  local opts=("$@")
  local i choice opt opt_name
  while true; do
    echo >&2
    echo "${BOLD}${prompt}${RESET}" >&2
    for i in "${!opts[@]}"; do
      printf "  ${CYAN}%d${RESET}) %s\n" "$((i + 1))" "${opts[$i]}" >&2
    done
    printf "${DIM}Enter = opcion 1. Numero/nombre, q = salir:${RESET} " >&2
    if [ -t 0 ] && [ -r /dev/tty ]; then
      read -r choice </dev/tty
    else
      read -r choice
    fi
    if [ -z "$choice" ]; then
      echo "${opts[0]}"
      return 0
    fi
    case "$choice" in
      q|quit|exit|salir)
        echo "__exit__"
        return 0
        ;;
      *[!0-9]*)
        for opt in "${opts[@]}"; do
          opt_name="${opt%% *}"
          if [ "$choice" = "$opt_name" ] || [ "$choice" = "$opt" ]; then
            echo "$opt"
            return 0
          fi
        done
        echo "${RED}Seleccion invalida:${RESET} $choice" >&2
        ;;
      *)
        if [ "$choice" -ge 1 ] && [ "$choice" -le "${#opts[@]}" ]; then
          echo "${opts[$((choice - 1))]}"
          return 0
        fi
        echo "${RED}Seleccion invalida:${RESET} $choice" >&2
        ;;
    esac
  done
}

prompt_path() {
  local default_path="$1"
  local answer
  printf "Ruta del proyecto [%s]: " "$default_path" >&2
  if [ -t 0 ] && [ -r /dev/tty ]; then
    read -r answer </dev/tty
  else
    read -r answer
  fi
  [ -n "${answer:-}" ] && echo "$answer" || echo "$default_path"
}

pick_target() {
  local detected
  detected="$(detect_target)"
  case "$detected" in
    codex)
      choose "IDE/agente destino:" \
        "codex (detectado)" \
        "claude" \
        "gemini" \
        "cursor" \
        "windsurf" \
        "opencode" \
        "kiro" \
        "agents"
      ;;
    claude)
      choose "IDE/agente destino:" \
        "claude (detectado)" \
        "codex" \
        "gemini" \
        "cursor" \
        "windsurf" \
        "opencode" \
        "kiro" \
        "agents"
      ;;
    gemini)
      choose "IDE/agente destino:" \
        "gemini (detectado)" \
        "codex" \
        "claude" \
        "cursor" \
        "windsurf" \
        "opencode" \
        "kiro" \
        "agents"
      ;;
    opencode)
      choose "IDE/agente destino:" \
        "opencode (detectado)" \
        "codex" \
        "claude" \
        "gemini" \
        "cursor" \
        "windsurf" \
        "kiro" \
        "agents"
      ;;
    kiro)
      choose "IDE/agente destino:" \
        "kiro (detectado)" \
        "codex" \
        "claude" \
        "gemini" \
        "cursor" \
        "windsurf" \
        "opencode" \
        "agents"
      ;;
    *)
      choose "IDE/agente destino:" \
        "codex" \
        "claude" \
        "gemini" \
        "cursor" \
        "windsurf" \
        "opencode" \
        "kiro" \
        "agents"
      ;;
  esac
}

doctor() {
  need_source
  echo
  echo "${GREEN}ICFES Skill OK.${RESET}"
  echo "  root:   $ROOT"
  echo "  skill:  $ROOT/skills/$SKILL_NAME"
  [ -f "$ROOT/agents/$AGENT_NAME" ] && echo "  agente: $ROOT/agents/$AGENT_NAME"
}

run_menu() {
  local action picked
  echo "${BOLD}ICFES Skill Setup${RESET}"
  echo "${DIM}-----------------${RESET}"
  echo "Instala skill ICFES para tu IDE/agente."
  echo "${DIM}Global = disponible en todos los proyectos. Proyecto = queda versionable en repo.${RESET}"

  action="$(choose "Que quieres hacer:" \
    "global (instalar para todos los proyectos)" \
    "current (instalar en este proyecto)" \
    "other (instalar en otro proyecto)" \
    "doctor (verificar instalacion)" \
    "exit (salir)")"
  action="${action%% *}"
  if [ "$action" = "__exit__" ]; then
    echo "${YELLOW}Instalacion cancelada.${RESET}"
    exit 0
  fi

  case "$action" in
    global)
      picked="$(pick_target)"
      if [ "$picked" = "__exit__" ]; then echo "${YELLOW}Instalacion cancelada.${RESET}"; exit 0; fi
      TARGET="$(normalize_target "${picked%% *}")"
      SCOPE="user"
      ;;
    current)
      picked="$(pick_target)"
      if [ "$picked" = "__exit__" ]; then echo "${YELLOW}Instalacion cancelada.${RESET}"; exit 0; fi
      TARGET="$(normalize_target "${picked%% *}")"
      SCOPE="project"
      PROJECT_DIR="$(pwd)"
      ;;
    other)
      picked="$(pick_target)"
      if [ "$picked" = "__exit__" ]; then echo "${YELLOW}Instalacion cancelada.${RESET}"; exit 0; fi
      TARGET="$(normalize_target "${picked%% *}")"
      SCOPE="project"
      PROJECT_DIR="$(prompt_path "$PROJECT_DIR")"
      ;;
    doctor)
      doctor
      exit 0
      ;;
    exit)
      echo "Instalacion cancelada."
      exit 0
      ;;
  esac
}

detect_target() {
  command -v codex >/dev/null 2>&1 && { echo "codex"; return; }
  command -v claude >/dev/null 2>&1 && { echo "claude"; return; }
  command -v gemini >/dev/null 2>&1 && { echo "gemini"; return; }
  command -v opencode >/dev/null 2>&1 && { echo "opencode"; return; }
  command -v kiro-cli >/dev/null 2>&1 && { echo "kiro"; return; }
  echo "agents"
}

dest_dir() {
  local target="$1"
  local scope="$2"
  local project="$3"
  case "$scope:$target" in
    user:codex) echo "$HOME/.codex/skills" ;;
    user:claude) echo "$HOME/.claude/skills" ;;
    user:gemini) echo "$HOME/.gemini/skills" ;;
    user:opencode) echo "$HOME/.config/opencode/skills" ;;
    user:kiro) echo "$HOME/.kiro/skills" ;;
    user:cursor) echo "$HOME/.agents/skills" ;;
    user:windsurf) echo "$HOME/.agents/skills" ;;
    user:agents) echo "$HOME/.agents/skills" ;;
    project:claude) echo "$project/.claude/skills" ;;
    project:opencode) echo "$project/.opencode/skills" ;;
    project:kiro) echo "$project/.kiro/skills" ;;
    project:*) echo "$project/.agents/skills" ;;
  esac
}

install_dir() {
  local src="$1"
  local dst="$2"
  mkdir -p "$(dirname "$dst")"
  rm -rf "$dst"
  if [ "$COPY_MODE" = "link" ]; then
    ln -s "$src" "$dst"
  else
    cp -R "$src" "$dst"
  fi
}

install_agent() {
  local target="$1"
  local scope="$2"
  local project="$3"
  local agent_src="$ROOT/agents/$AGENT_NAME"
  [ -f "$agent_src" ] || return 0

  if [ "$scope" = "project" ]; then
    mkdir -p "$project/agents"
    cp "$agent_src" "$project/agents/$AGENT_NAME"
    return 0
  fi

  case "$target" in
    codex) mkdir -p "$HOME/.codex/agents"; cp "$agent_src" "$HOME/.codex/agents/$AGENT_NAME" ;;
    claude) mkdir -p "$HOME/.claude/agents"; cp "$agent_src" "$HOME/.claude/agents/$AGENT_NAME" ;;
    gemini) mkdir -p "$HOME/.gemini/agents"; cp "$agent_src" "$HOME/.gemini/agents/$AGENT_NAME" ;;
    opencode) mkdir -p "$HOME/.config/opencode/agents"; cp "$agent_src" "$HOME/.config/opencode/agents/$AGENT_NAME" ;;
    kiro) mkdir -p "$HOME/.kiro/agents"; cp "$agent_src" "$HOME/.kiro/agents/$AGENT_NAME" ;;
    cursor|windsurf|agents) mkdir -p "$HOME/.agents/agents"; cp "$agent_src" "$HOME/.agents/agents/$AGENT_NAME" ;;
  esac
}

run_install() {
  local target="$1"
  local scope="$2"
  local project="$3"
  need_source
  case "$target" in
    codex|claude|gemini|cursor|windsurf|opencode|kiro|agents) ;;
    *) echo "Target invalido: $target" >&2; exit 1 ;;
  esac
  case "$scope" in
    user|project) ;;
    *) echo "Scope invalido: $scope" >&2; exit 1 ;;
  esac

  local base dst
  base="$(dest_dir "$target" "$scope" "$project")"
  dst="$base/$SKILL_NAME"
  mkdir -p "$base"
  install_dir "$ROOT/skills/$SKILL_NAME" "$dst"
  install_agent "$target" "$scope" "$project"

  echo
  echo "${GREEN}ICFES skill instalado.${RESET}"
  echo "  target: $target"
  echo "  scope:  $scope"
  echo "  skill:  $dst"
  if [ "$scope" = "project" ]; then
    echo "  agente: $project/agents/$AGENT_NAME"
  fi
}

if [ -z "$TARGET" ] || [ -z "$SCOPE" ]; then
  run_menu
fi

TARGET="$(normalize_target "$TARGET")"
SCOPE="$(normalize_scope "$SCOPE")"
run_install "$TARGET" "$SCOPE" "$PROJECT_DIR"
